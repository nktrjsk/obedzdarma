        box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.45);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      /* Hand off to the corner slip once the gutter clears the content column.
         Placed after the base rule so it wins over `.tape { display: flex }`. */
      @media (min-width: 1400px) {
        .tape { display: none; }
      }
      .tape-track {
        height: 3px;
        background: var(--paper-faint);
      }
      /* The "paid" portion of the bill, rung up left→right as you scroll.
         Driven by scaleX (compositor-only, no layout) rather than width. */
      .tape-fill {
        display: block;
        height: 100%;
        width: 100%;
        background: var(--acid);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .tape-inner {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        height: 2.4rem;
        max-width: var(--maxw);
        width: 100%;
        margin-inline: auto;
        padding-inline: clamp(1rem, 4vw, 1.5rem);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
      }
      .tape-mark {
        color: var(--ink);
        opacity: 0.65;
      }
      .tape-name {
        flex: 0 1 auto;
        min-width: 0;
        max-width: 62%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 700;
        letter-spacing: 0.08em;
      }
      .tape-leader {
        flex: 1;
        border-bottom: 1px dotted rgba(11, 11, 12, 0.4);
        transform: translateY(-0.18em);
      }
      .tape-sum {
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
      }
      /* Keep the footer clear of the fixed tape (only while the tape is shown). */
      @media (max-width: 1399.98px) {
        html:not(.receipt-hidden) body { padding-bottom: 3.4rem; }
      }

      /* ---- FOOTER ---- */
      .footer {
        margin-top: clamp(4rem, 10vw, 7rem);
        padding-block: clamp(2.5rem, 5vw, 4rem);
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.6;
      }
      .footer-why {
        max-width: 46ch;
        margin: 0 0 clamp(2rem, 4vw, 3rem);
        color: var(--paper);
        font-weight: 300;
        text-wrap: pretty;
      }
      .footer-lead {
        margin: 0 0 1rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .footer-read ul {
        list-style: none;
        margin: 0 0 clamp(2rem, 4vw, 3rem);
        padding: 0;
        display: grid;
        gap: 1.1rem;
        max-width: 44ch;
      }
      .footer-read li {
        color: var(--paper);
      }
      .fr-author {
        font-weight: 600;
      }
      .fr-note {
        display: block;
        margin-top: 0.15rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .footer-open {
        margin: 0;
      }
      .footer-open a {
        color: var(--paper);
        text-decoration: none;
        border-bottom: 1px solid var(--muted);
        padding-bottom: 2px;
        transition:
          color 160ms ease,
          border-color 160ms ease;
      }
      .footer-open a:hover,
      .footer-open a:focus-visible {
        color: var(--acid);
        border-color: var(--acid);
      }
      .footer-license {
        margin: 0.75rem 0 0;
        font-size: 0.85rem;
      }
      .footer-mark {
        margin: clamp(2.5rem, 5vw, 4rem) 0 0;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      @media (prefers-reduced-motion: reduce) {
        .footer-open a {
          transition: none;
        }
      }
    </style>

    <script>
      // Reflect the section crossing the viewport's vertical center into the
      // receipt: the current line is "active", everything above it is "paid"
      // (is-past). Read-only: observes position, never alters scroll.
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.receipt a'),
      );
      const order = links.map((l) => l.dataset.target);
      // Section labels for the bottom tape, read straight from the receipt
      // markup so the two affordances never drift out of sync.
      const meta = links.map((l) => ({
        name: l.querySelector('.r-name')?.textContent?.trim() ?? '',
        cost: l.querySelector('.r-cost')?.textContent?.trim() ?? '',
      }));
      const tapeName = document.querySelector<HTMLElement>('.tape-name');
      const tapeFill = document.querySelector<HTMLElement>('.tape-fill');
      const visible = new Set<string>();
      let lastIdx = -1;

      const setActive = () => {
        const idx = order.findIndex((id) => id && visible.has(id));
        // Keep the last reached line lit when scrolled past the final section
        // (into closer / sources), so the bill stays fully rung up.
        if (idx !== -1) lastIdx = idx;
        links.forEach((l, i) => {
          l.classList.toggle('is-active', i === lastIdx);
          l.classList.toggle('is-past', lastIdx > -1 && i < lastIdx);
        });
        // Ring up the bottom tape: name the current line, fill the "paid"
        // proportion. Before the first section, rest on the store name at 0.
        if (tapeFill)
          tapeFill.style.transform = `scaleX(${
            lastIdx > -1 ? (lastIdx + 1) / meta.length : 0
          })`;
        if (tapeName && lastIdx > -1) {
          const m = meta[lastIdx];
          tapeName.textContent = m.cost ? `${m.name} · ${m.cost}` : m.name;
        }
      };

      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const id = (e.target as HTMLElement).id;
            if (e.isIntersecting) visible.add(id);
            else visible.delete(id);
          }
          setActive();
        },
        // A 1px-tall band at the viewport's middle: exactly one full-width
        // section occupies it at a time.
        { rootMargin: '-50% 0px -50% 0px' },
      );

      document.querySelectorAll('[data-rail]').forEach((s) => obs.observe(s));

      // Hide / restore the receipt, remembering the choice.
      const root = document.documentElement;
      const KEY = 'receiptHidden';
      const setHidden = (hidden: boolean) => {
        root.classList.toggle('receipt-hidden', hidden);
        try {
          localStorage.setItem(KEY, hidden ? '1' : '0');
        } catch (e) {}
      };
      document
        .querySelector('.r-close')
        ?.addEventListener('click', () => setHidden(true));
      document
        .querySelector('.receipt-reopen')
        ?.addEventListener('click', () => setHidden(false));
    </script>
  </body>
</html>
