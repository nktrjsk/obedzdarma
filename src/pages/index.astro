---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import friedman from '../assets/origin/friedman.jpg';
import heinlein from '../assets/origin/heinlein.jpg';
import saloon from '../assets/origin/saloon.jpg';
import '../styles/global.css';

const currencies = (await getCollection('currencies')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Wayfinding "receipt": the page spine as line items. Clean nominative labels
// (the currency titles are in the instrumental case — "Soukromím" — which reads
// oddly in a nav) plus the "currency" each section is paid in.
const railMeta: Record<string, { label: string; cost?: string }> = {
  setup: { label: 'Úvod' },
  soukromi: { label: 'Soukromí', cost: 'data' },
  efektivita: { label: 'Efektivita', cost: 'daně' },
  prostredi: { label: 'Prostředí', cost: 'CO₂' },
  inflace: { label: 'Inflace', cost: '%' },
  ekonomie: { label: 'Ekonomie' },
  // The one line item that rings up a gain instead of a cost — the twist.
  smena: { label: 'Směna', cost: 'zisk' },
};
const sections = [
  { id: 'setup', ...railMeta.setup },
  ...currencies.map((c) => ({ id: c.id, ...(railMeta[c.id] ?? { label: c.data.title }) })),
  { id: 'ekonomie', ...railMeta.ekonomie },
  { id: 'smena', ...railMeta.smena },
];

// Source numbering: currency anchor facts take [1..N], the hardcoded IBM
// citation is [N+1], and any example-level sources follow as [N+2..]. We map
// each example object to its ref number so the [n] and the "Zdroje" entry stay
// in sync no matter how many examples carry a source.
const exSourceRefs = new Map<unknown, number>();
const exampleSources: { ref: number; label: string; url?: string }[] = [];
let nextRef = currencies.length + 2;
for (const c of currencies) {
  for (const ex of c.data.examples) {
    if (ex.source) {
      exSourceRefs.set(ex, nextRef);
      exampleSources.push({ ref: nextRef, ...ex.source });
      nextRef += 1;
    }
  }
}
// The twist section's anchor fact (Ricardo) takes the next free ref, after all
// currency facts, the IBM citation, and any example-level sources — so adding
// an example source later can't collide with it.
const tradeRef = nextRef;

const title = 'Oběd zdarma neexistuje';
const description =
  'Všechno má svou cenu. A kolik stojí „zdarma“? Soukromí, efektivita, životní prostředí, inflace — čím doopravdy platíš.';

// Social share card (public/og.png, 1200×630). Absolute URL is required by OG;
// Astro.site (astro.config) supplies the origin. See og-image-static-for-now.
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt =
  'Účtenka „Oběd zdarma neexistuje“ — za „zdarma“ platíš soukromím (data), efektivitou (daně), životním prostředím (CO₂) a inflací (%).';
const canonical = new URL('/', Astro.site).href;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍽️</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Oběd zdarma neexistuje" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Restore the user's receipt visibility choice before paint (no flash). -->
    <script is:inline>
      try {
        if (localStorage.getItem('receiptHidden') === '1')
          document.documentElement.classList.add('receipt-hidden');
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Skip past the wayfinding receipt (the first focusable region on wide
         screens) straight to the reading experience. Visually hidden until
         keyboard focus. -->
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <!-- Ink→acid duotone filter for the origin photos: maps shadows to --ink
         (#0b0b0c) and highlights to --acid (#e8ff2a) via luminance, so the
         archival photos read in the brand's two colors, not as stray full-color
         imagery. Hidden; referenced from CSS as filter: url(#duotone). -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <filter id="duotone" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0      0      0      1 0"
        />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.043 0.957" />
          <feFuncG type="table" tableValues="0.043 0.945" />
          <feFuncB type="table" tableValues="0.047 0.918" />
        </feComponentTransfer>
      </filter>
    </svg>

    <!-- Wayfinding "receipt" — the page rings up sections like line items on a
         bill: passed = paid (filled), current = being scanned (acid), upcoming
         = pending. Reflects scroll position (read-only, no scroll-hijack);
         clicking is a native anchor jump. Shown only where the side gutter is
         wide enough to clear the text column. -->
    <nav class="receipt" aria-label="Obsah stránky">
      <div class="r-paper">
        <button class="r-close" type="button" aria-label="Skrýt účtenku">×</button>
        <p class="r-store">Oběd zdarma</p>
        <p class="r-meta">∗ účtenka ∗<br />obedzdarma.cz</p>
        <ol>
          {
            sections.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-target={s.id}
                  class={s.cost ? 'r-item' : 'r-item r-item--note'}>
                  <span class="r-name">{s.label}</span>
                  {s.cost && (
                    <>
                      <span class="r-leader" aria-hidden="true" />
                      <span class="r-cost">{s.cost}</span>
                    </>
                  )}
                </a>
              </li>
            ))
          }
        </ol>
        <p class="r-total">
          <span>Celkem</span>
          <span class="r-sum">∞</span>
        </p>
        <div class="r-barcode" aria-hidden="true" />
      </div>
    </nav>
    <button class="receipt-reopen" type="button" aria-label="Zobrazit účtenku">
      Účtenka
    </button>
    <!-- Bottom "register tape" — the receipt's progress, adapted for screens
         too narrow for the corner slip. A paper strip pinned to the bottom edge
         that rings up the page as you scroll: an acid fill grows left→right as
         sections are "paid", the current line item named on the left, the ∞
         total on the right. Read-only reflection of scroll position (no
         scroll-hijack). aria-hidden — the heading structure already gives
         assistive tech the canonical wayfinding, so this stays a purely visual
         enhancement and never announces on every scroll. -->
    <div class="tape" aria-hidden="true">
      <div class="tape-track"><span class="tape-fill"></span></div>
      <div class="tape-inner">
        <span class="tape-mark">∗</span>
        <span class="tape-name">Oběd zdarma</span>
        <span class="tape-leader"></span>
        <span class="tape-sum">∞</span>
      </div>
    </div>
    <main id="obsah" tabindex="-1">
      <!-- 1. HERO -->
      <header class="hero">
        <div class="wrap">
          <p class="kicker">Bez práce nejsou koláče</p>
          <h1 class="display hero-title">
            Všechno má<br />svou cenu.
          </h1>
          <p class="hero-sub display">
            A kolik stojí <span class="mark">„zdarma“</span>?
          </p>
          <p class="hero-stand">
            Appka zdarma. Doprava zdarma. Účet zdarma. Penězi za ně neplatíš.
            Platíš jinak.
          </p>
        </div>
      </header>

      <!-- 2. SETUP -->
      <section id="setup" class="setup" data-rail>
        <div class="wrap setup-inner">
          <div class="setup-copy">
            <p class="lead">
              Myšlenku <strong>„obědu zdarma“</strong> proslavil ekonom
              <strong>Milton Friedman</strong>. Ještě před ním ji ale rozšířil
              spisovatel <strong>Robert A. Heinlein</strong> v románu
              <em>Měsíc je drsná milenka</em>.
            </p>
            <p class="lead">
              Ani jeden ji ale nevymyslel: pochází z&nbsp;amerických barů, které
              k&nbsp;pití lákaly na „oběd zdarma“. I&nbsp;ten byl ovšem zaplacený
              v&nbsp;ceně pití.
            </p>
            <p class="lead">
              Pointa je prostá: <span class="acid">nic není zadarmo</span>. Když
              za něco neplatíš penězi, platíš jinak. Jen je to méně vidět.
            </p>
          </div>

          <figure class="origin-collage" aria-label="Původ myšlenky obědu zdarma">
            <div class="oc-card oc-saloon">
              <Image
                src={saloon}
                alt="Interiér amerického baru kolem roku 1900"
                widths={[460, 900, 1400]}
                sizes="(max-width: 900px) 76vw, 31rem"
              />
              <figcaption>saloon · 19. stol. · <span class="acid">původ</span></figcaption>
            </div>
            <div class="oc-card oc-friedman">
              <Image
                src={friedman}
                alt="Portrét ekonoma Miltona Friedmana"
                widths={[300, 560, 840]}
                sizes="(max-width: 900px) 50vw, 22rem"
              />
              <figcaption>Friedman · <span class="acid">proslavil</span></figcaption>
            </div>
            <div class="oc-card oc-heinlein">
              <Image
                src={heinlein}
                alt="Portrét spisovatele Roberta A. Heinleina"
                widths={[280, 520, 760]}
                sizes="(max-width: 900px) 44vw, 19rem"
              />
              <figcaption>Heinlein · <span class="acid">rozšířil</span></figcaption>
            </div>
          </figure>
        </div>
      </section>

      <!-- 3. THE CURRENCIES -->
      <section class="currencies">
        <div class="wrap">
          <h2 class="section-head display">Čím platíš?</h2>
        </div>
        {
          currencies.map((c, i) => (
            <article class="currency" id={c.id} data-rail>
              <div class="wrap currency-inner">
                <div class="currency-head">
                  <span class="currency-no">0{i + 1}</span>
                  <span class="currency-icon" aria-hidden="true">
                    {c.data.icon}
                  </span>
                  <h3 class="currency-title display">{c.data.title}</h3>
                </div>
                <p class="currency-claim display">{c.data.claim}</p>
                <p class="currency-fact">
                  {c.data.fact}
                  <a
                    class="src-ref"
                    href={`#zdroj-${i + 1}`}
                    aria-label={`Zdroj ${i + 1}`}>[{i + 1}]</a
                  >
                </p>
                <ul class="examples">
                  {c.data.examples.map((ex) => (
                    <li>
                      <span class="ex-name">{ex.name}</span>
                      {ex.note && (
                        <span class="ex-note">
                          {ex.note}
                          {ex.source && (
                            <a
                              class="src-ref"
                              href={`#zdroj-${exSourceRefs.get(ex)}`}
                              aria-label={`Zdroj ${exSourceRefs.get(ex)}`}>
                              [{exSourceRefs.get(ex)}]
                            </a>
                          )}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </section>

      <!-- 4. ECONOMICS -->
      <section class="economics" id="ekonomie" data-rail>
        <div class="wrap">
          <h2 class="section-head display">Ekonomie za „obědem zdarma“</h2>
          <p class="lead">
            Někdy je „zdarma“ promyšlený tah — ne podvod, ale investice. Kdo
            rozdává, počítá s&nbsp;tím, že se mu to vrátí. Otázka není
            <em>jestli</em>, ale <em>kdy</em>.
          </p>

          <ol class="mechanisms">
            <li>
              <h3 class="mech-title display">Loss leader</h3>
              <p class="mech-body">
                Nabídnou ti něco pod cenou nebo zdarma, aby tě nalákali
                dovnitř. Pak ale vydělají na tom, co dokoupíš. Přivede tě
                levný rohlík, ale odneseš si celý nákup.
              </p>
            </li>
            <li>
              <h3 class="mech-title display">Freemium</h3>
              <p class="mech-body">
                Základ je zadarmo, zisky tvoří platící menšina. Pár procent
                předplatitelů dotuje ostatní, a ti zase přináší službě takovou
                hodnotu, za kterou předplatitelé platí.
              </p>
            </li>
            <li>
              <h3 class="mech-title display">Doplněk zdarma</h3>
              <p class="mech-body">
                Rozdávají zadarmo to, co pak zvýší poptávku po tom, co prodávají.
                Software je sice zadarmo, ale o to je hardware, cloud a podpora
                kolem něj dražší.
              </p>
            </li>
          </ol>

          <p class="currency-fact economics-fact">
            Red Hat postavil miliardový byznys na softwaru, který je zdarma
            a&nbsp;otevřený. V&nbsp;roce 2019 ho IBM koupilo za 34&nbsp;miliard
            dolarů.
            <a class="src-ref" href="#zdroj-5" aria-label="Zdroj 5">[5]</a>
          </p>

          <p class="lead economics-closer">
            Ať je konkrétní situace jakákoliv,
            <span class="acid">oběd zdarma v ní nenajdeš</span>. Jen se mění to,
            kdo, kdy a&nbsp;čím ten oběd zaplatí.
          </p>
        </div>
      </section>

      <!-- 5. CLOSER -->
      <section class="closer">
        <div class="wrap">
          <p class="closer-line display">
            Příště, až uvidíš <span class="mark">„zdarma“</span>,<br />
            zeptej se: <span class="acid">čím platím?</span>
          </p>
        </div>
      </section>

      <!-- 5b. THE TWIST — the one real "free lunch": voluntary, positive-sum
           exchange. Comes after the acid closer on purpose: the bright
           challenge ("čím platím?"), then the quiet answer. It doesn't undo the
           thesis — it completes it. The four currencies are costs you never
           agreed to; this is the case where the honest answer is "you both gain". -->
      <section class="twist" id="smena" data-rail>
        <div class="wrap">
          <h2 class="section-head display">A přece jeden existuje</h2>
          <p class="lead">
            Celou dobu hledáme skrytou cenu. Teď obrať list. Je jediná situace,
            kdy <span class="mark">„zdarma“</span> není past — a naopak z&nbsp;ní
            odejdeš bohatší, než jsi přišel.
          </p>

          <ol class="mechanisms twist-beats">
            <li>
              <h3 class="mech-title display">Pocit</h3>
              <p class="mech-body">
                Mám doma hromadu čokolády, ale nejradši mám jablka. Ty máš plný
                koš jablek a&nbsp;miluješ čokoládu. Vyměníme se. Nikdo nevyrobil
                ani kousek navíc — a&nbsp;přesto jsme teď oba spokojenější.
              </p>
            </li>
            <li>
              <h3 class="mech-title display">Proč to funguje</h3>
              <p class="mech-body">
                Hodnota není napevno v&nbsp;té věci. Je v&nbsp;tom, jak moc ji
                chce ten, kdo ji zrovna drží. Desátá čokoláda mě už skoro netěší,
                tvoje desáté jablko netěší tebe. Vyměníme, čeho máme nazbyt, za
                to, po čem toužíme — a&nbsp;hodnota se nepřesune. Vznikne.
              </p>
            </li>
            <li>
              <h3 class="mech-title display">Motor</h3>
              <p class="mech-body">
                Roztoč to přes celou ekonomiku a&nbsp;máš její pohon. Každý dělá
                hlavně to, v&nbsp;čem je poměrně nejlepší, a&nbsp;o zbytek se
                směňuje. Vydělá i&nbsp;ten, kdo je úplně ve všem horší — vyplatí
                se mu dělat to, kde ztrácí nejmíň.
              </p>
            </li>
          </ol>

          <p class="currency-fact twist-fact">
            I&nbsp;když jedna země zvládne vyrobit všechno levněji než druhá,
            oběma se pořád vyplatí obchodovat a&nbsp;rozdělit si práci. Říká se
            tomu komparativní výhoda a&nbsp;ekonom David Ricardo ji popsal už
            roku 1817.
            <a class="src-ref" href={`#zdroj-${tradeRef}`} aria-label={`Zdroj ${tradeRef}`}>[{tradeRef}]</a>
          </p>

          <p class="lead twist-guard">
            Jeden háček to má. Platí to jen u&nbsp;směny, která je
            <span class="acid">dobrovolná</span> a&nbsp;při níž
            <span class="acid">víš, do čeho jdeš</span>. Přesně tím se liší od
            čtyř měn nahoře: za ty platíš, aniž bys kývl — cena je schovaná,
            vnucená, nebo hozená na někoho jiného. Tady souhlasíš a&nbsp;víš, co
            dáváš i&nbsp;co dostáváš.
          </p>

          <!-- Inverted receipt: the page's motif turned on its head. Everywhere
               else a slip rings up a hidden cost and totals ∞; this one rings up
               a swap and both sides total a gain. No prices — the gain is
               subjective, which is the whole point. -->
          <figure class="trade" aria-label="Účtenka směny, kde vydělají oba">
            <div class="trade-slip">
              <p class="trade-head">Směna</p>
              <p class="trade-meta">∗ dobrovolná ∗<br />oba vědí, do čeho jdou</p>
              <div class="trade-cols">
                <div class="trade-side">
                  <p class="trade-who">Ty</p>
                  <p class="trade-move"><span>dáš</span> čokoládu, které máš až moc</p>
                  <p class="trade-move"><span>dostaneš</span> jablka, po kterých toužíš</p>
                  <p class="trade-gain">bohatší než&nbsp;dřív</p>
                </div>
                <div class="trade-side">
                  <p class="trade-who">Protějšek</p>
                  <p class="trade-move"><span>dá</span> jablka, kterých má až moc</p>
                  <p class="trade-move"><span>dostane</span> čokoládu, po které touží</p>
                  <p class="trade-gain">bohatší než&nbsp;dřív</p>
                </div>
              </div>
              <p class="trade-total"><span>Celkem</span><span class="trade-sum">oba víc</span></p>
            </div>
            <figcaption class="trade-cap">
              Nikdo nepřidal ani kousek. Hodnota přesto vznikla — z&nbsp;rozdílu
              v&nbsp;tom, co si kdo cení.
            </figcaption>
          </figure>

          <p class="twist-final display">
            Jeden oběd zdarma přece existuje —<br />
            ten, na kterém <span class="acid">vyděláte oba</span>.
          </p>
        </div>
      </section>

      <!-- 6. SOURCES (quiet, end of page) -->
      <section class="sources" id="zdroje">
        <div class="wrap">
          <h2 class="sources-head">Zdroje</h2>
          <ol class="sources-list">
            {
              currencies.map((c, i) => (
                <li id={`zdroj-${i + 1}`}>
                  {c.data.source.url ? (
                    <a href={c.data.source.url} target="_blank" rel="noopener noreferrer">
                      {c.data.source.label}
                    </a>
                  ) : (
                    c.data.source.label
                  )}
                </li>
              ))
            }
            <li id="zdroj-5">
              <a
                href="https://newsroom.ibm.com/2019-07-09-IBM-Closes-Landmark-Acquisition-of-Red-Hat-for-34-Billion-Defines-Open-Hybrid-Cloud-Future"
                target="_blank"
                rel="noopener noreferrer">
                IBM — IBM Closes Landmark Acquisition of Red Hat for $34 Billion
                (2019)
              </a>
            </li>
            {
              exampleSources.map((s) => (
                <li id={`zdroj-${s.ref}`}>
                  {s.url ? (
                    <a href={s.url} target="_blank" rel="noopener noreferrer">
                      {s.label}
                    </a>
                  ) : (
                    s.label
                  )}
                </li>
              ))
            }
            <li id={`zdroj-${tradeRef}`}>
              <a
                href="https://www.econlib.org/library/Ricardo/ricP.html"
                target="_blank"
                rel="noopener noreferrer">
                David Ricardo — On the Principles of Political Economy and
                Taxation (1817), kap. 7 „On Foreign Trade“
              </a>
            </li>
          </ol>
          <p class="image-credits">
            Obrázky:
            <a
              href="https://commons.wikimedia.org/wiki/File:Portrait_of_Milton_Friedman.jpg"
              target="_blank"
              rel="noopener noreferrer">Milton Friedman</a
            > (The Friedman Foundation, CC0) ·
            <a
              href="https://commons.wikimedia.org/wiki/File:Robert_A._Heinlein_1938.jpg"
              target="_blank"
              rel="noopener noreferrer">Robert A. Heinlein</a
            > (1938, public domain) ·
            <a
              href="https://commons.wikimedia.org/wiki/File:Inside_the_Yellow_Aster_Saloon,_Randsburg,_California,_ca.1900_(CHS-1798).jpg"
              target="_blank"
              rel="noopener noreferrer">saloon</a
            > (C. C. Pierce, ca. 1900, public domain) — Wikimedia Commons.
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer-why">
          Otevřený, neplacený web o tom, že nic není zadarmo. Kód i texty si
          můžeš přečíst, ověřit a&nbsp;šířit dál.
        </p>

        <div class="footer-read">
          <p class="footer-lead">Čti dál</p>
          <ul>
            <li>
              <span class="fr-author">Adam Smith</span> — Bohatství národů
              <span class="fr-note">dělba práce: společně vyrobíme víc než každý sám</span>
            </li>
            <li>
              <span class="fr-author">Frédéric Bastiat</span> — Co je vidět a co není vidět
              <span class="fr-note">skrytá cena: i to, co nevidíš, platíš</span>
            </li>
            <li>
              <span class="fr-author">Milton Friedman</span> — Svoboda volby
              <span class="fr-note">dobrovolná směna: obchod s&nbsp;kladným součtem</span>
            </li>
          </ul>
        </div>

        <p class="footer-open">
